# ---------------------------------------------------------------------------
# Layout Service (Agent 2 - Layout & Geometric)
# Copy to `.env`. `.env` is git-ignored. No LLM/model access needed.
# ---------------------------------------------------------------------------

# --- AWS access (SSO) ---
AWS_PROFILE=sdg
AWS_REGION=us-west-2

# --- Shared resources (from the api-project stack) ---
DATA_BUCKET=slidegen-data-363811234194-us-west-2
DDB_TABLE=ArchitectureGenerator

# --- Slide profile (16:9 default) ---
SLIDE_WIDTH_IN=13.333
SLIDE_HEIGHT_IN=7.5
SAFE_MARGIN_IN=0.3

# --- Local dev identity ---
LOCAL_TENANT_ID=tenant-local-dev
