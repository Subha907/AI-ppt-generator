# ---------------------------------------------------------------------------
# Architecture Intelligence Service (Agent 1 - Solution Architect)
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- AWS access (SSO) ---
AWS_PROFILE=sdg
AWS_REGION=us-west-2

# --- Shared resources (must match the api-project stack outputs) ---
DATA_BUCKET=slidegen-data-363811234194-us-west-2
DDB_TABLE=ArchitectureGenerator
KNOWLEDGE_BASE_ID=WAHAWT3ZPO

# --- Generation model ---
# Nova Pro is INFERENCE_PROFILE-only, so use the cross-region profile id.
GENERATION_MODEL_ID=us.amazon.nova-pro-v1:0
GENERATION_PROVIDER=nova

# --- Retrieval ---
RETRIEVAL_MAX_RESULTS=12

# --- Local dev identity (stands in for orchestrator-injected context) ---
LOCAL_TENANT_ID=tenant-local-dev
