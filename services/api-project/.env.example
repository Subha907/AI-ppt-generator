# ---------------------------------------------------------------------------
# API and Project Service - local configuration
# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- AWS access (SSO) ------------------------------------------------------
# The service uses your AWS CLI SSO profile. Run `aws sso login --profile <name>`
# before starting the service. boto3 picks up the profile from AWS_PROFILE.
# NOTE: AWS_PROFILE is your SSO *profile* name (from ~/.aws/config). Its
# sso_region (where Identity Center lives) is independent of AWS_REGION (where
# this app's resources live). SSO in ap-south-1 + resources in us-west-2 is fine.
AWS_PROFILE=sdg
AWS_REGION=us-west-2

# --- Resource names (must match the deployed CloudFormation stack) ---------
# These are populated from the CloudFormation stack outputs after deploy.
DATA_BUCKET=
VECTOR_BUCKET=
DDB_TABLE=ArchitectureGenerator
KNOWLEDGE_BASE_ID=
DATA_SOURCE_ID=

# --- Local dev identity (stands in for Cognito claims) ---------------------
# In production tenantId/userId come from verified JWT claims. Locally we
# inject them so tenant isolation logic still runs end-to-end.
LOCAL_TENANT_ID=tenant-local-dev
LOCAL_USER_ID=user-local-dev

# --- Upload constraints ----------------------------------------------------
PRESIGN_EXPIRY_SECONDS=900
MAX_UPLOAD_BYTES=52428800
