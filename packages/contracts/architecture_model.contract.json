{
  "$id": "https://slidegen/contracts/architecture-model",
  "title": "ArchitectureModel",
  "description": "Agent 1 (Solution Architect) output. A logical architecture topology grounded in project RFP evidence. Contains NO coordinates or PPT-specific details - layout is Agent 2's responsibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "jobId",
    "architectureType",
    "title",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "projectId": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "architectureType": {
      "type": "string",
      "enum": ["BUSINESS", "APPLICATION", "DEPLOYMENT"]
    },
    "title": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "approved"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "approved": { "type": "boolean" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable, unique node identifier used across correction cycles."
          },
          "type": {
            "type": "string",
            "description": "Semantic node type. For DEPLOYMENT: CONTAINER, COMPUTE, NETWORK, STORAGE, DATABASE, INTEGRATION, EDGE, SECURITY, OBSERVABILITY, EXTERNAL. For BUSINESS/APPLICATION: corresponding semantic types.",
            "enum": [
              "CONTAINER",
              "ACCOUNT",
              "REGION",
              "VPC",
              "AVAILABILITYZONE",
              "SUBNET",
              "COMPUTE",
              "NETWORK",
              "STORAGE",
              "DATABASE",
              "INTEGRATION",
              "EDGE",
              "SECURITY",
              "OBSERVABILITY",
              "EXTERNAL",
              "ACTOR",
              "PROCESS",
              "CAPABILITY",
              "SERVICE",
              "DATASTORE",
              "COMPONENT"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "parentId": {
            "type": ["string", "null"],
            "default": null,
            "description": "ID of the containing node (e.g. a VPC or subnet), or null for top-level."
          },
          "properties": {
            "type": ["object", "null"],
            "default": {},
            "properties": {
              "awsService": {
                "type": ["string", "null"],
                "description": "AWS service name when applicable, e.g. 'Amazon ECS'."
              }
            },
            "additionalProperties": true
          },
          "evidenceIds": {
            "type": "array",
            "default": [],
            "items": { "type": "string" },
            "description": "IDs of retrieved evidence chunks that justify this node."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Must reference an existing node id."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Must reference an existing node id."
          },
          "protocol": { "type": ["string", "null"] },
          "label": { "type": ["string", "null"] }
        }
      }
    },
    "qualityAttributes": {
      "type": "array",
      "default": [],
      "items": { "type": "string" },
      "description": "e.g. availability, security, observability, scalability."
    }
  }
}
